CONFIRM_TMDB_LIST_WRITES=NUVIO-TMDB-LISTS
ALLOW_TMDB_LIST_BOOTSTRAP=2125
NUVIO_SYNC_CONCURRENCY=6
TMDB_HTTP_CONCURRENCY=16
NUVIO_SYNC_CONCURRENCY=12
TMDB_WORLDWIDE_REGION_CONCURRENCY=12
NUVIO_SYNC_WRITE_CONCURRENCY=20
TMDB_CREATE_INTERVAL_MS=2500
TMDB_SPAM_COOLDOWN_MS=60000
TMDB_CLEAR_SETTLE_MS=10000
